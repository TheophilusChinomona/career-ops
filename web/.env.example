# Copy this file to .env.local and fill in real values.

# DATABASE_URL points to the ParadeDB `careerops` database.
# Example: postgresql://postgres:password@localhost:5432/careerops
DATABASE_URL=postgresql://user:password@localhost:5432/careerops

# Better Auth secret — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-here

# Public URL of your app (used by Better Auth for redirects)
BETTER_AUTH_URL=http://localhost:3000

# Encryption key — must be exactly 32 characters
APP_ENCRYPTION_KEY=your-32-char-encryption-key-here!

# LLM provider: claude | openai | gemini (default: claude)
LLM_PROVIDER=claude

# Optional: override the default model for the selected LLM_PROVIDER
LLM_MODEL=

# API keys — set only for the provider(s) you use
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
FIRECRAWL_API_KEY=
